{
  "name": "relay-team-builder",
  "version": "0.1.0",
  "description": "Build relay teams from Excel swimmer data",
  "main": "main.js",
  "scripts": {
    "start": "npx electron .",
    "start:backend": "cd ../backend && poetry run python -m uvicorn api_server:app --host 127.0.0.1 --port 8765",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.relayteambuilder.app",
    "productName": "Relay Team Builder",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "constants.js",
      "pdfExport.js",
      "src/**"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*", "!.venv/**", "!**/__pycache__/**", "!**/*.pyc"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Relay Team Builder"
    }
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "pdfkit": "^0.15.0",
    "sql.js": "^1.14.0"
  }
}
